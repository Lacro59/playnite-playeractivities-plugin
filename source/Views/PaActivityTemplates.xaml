<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:PlayerActivities.Views"
                    xmlns:controls="clr-namespace:PlayerActivities.Controls"
                    xmlns:convertersshared="clr-namespace:CommonPluginsShared.Converters">

    <!-- Shared activity-line templates for PaView + PluginActivities (SS/SV strips; no per-line SourceIcon). -->
    <!-- Strips resolve GameContext via ElementName=PART_Root Tag (group card or mono ActivityList). -->
    <convertersshared:LocalDateConverter x:Key="PaActivityLocalDateConverter" />

    <DataTemplate x:Key="PaActivityAchievementsUnlocked">
        <DockPanel Margin="0,0,0,10">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock DockPanel.Dock="Right"
                           Style="{DynamicResource BaseTextBlockStyle}"
                           Foreground="{DynamicResource TextBrushDarker}"
                           ToolTip="{Binding DateActivity, Converter={StaticResource PaActivityLocalDateConverter}}"
                           Text="{Binding TimeAgo}" />
                <!-- Label: Binding.StringFormat cannot take DynamicResource (XamlParseException) -->
                <Label Margin="0,0,10,0" Padding="0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextBrush}"
                       Content="{Binding Value}"
                       ContentStringFormat="{DynamicResource LOCPaSuccessStoryUnlocked}" />
            </DockPanel>
            <controls:PaAchievementStrip
                GameContext="{Binding ElementName=PART_Root, Path=Tag.GameContext}"
                DateUnlocked="{Binding DateActivity}" />
        </DockPanel>
    </DataTemplate>

    <DataTemplate x:Key="PaActivityAchievementsGoal">
        <DockPanel Margin="0,0,0,10">
            <TextBlock DockPanel.Dock="Right"
                       Style="{DynamicResource BaseTextBlockStyle}"
                       Foreground="{DynamicResource TextBrushDarker}"
                       ToolTip="{Binding DateActivity, Converter={StaticResource PaActivityLocalDateConverter}}"
                       Text="{Binding TimeAgo}" />
            <Label Margin="0,0,10,0" Padding="0"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource TextBrush}"
                   Content="{Binding Value}"
                   ContentStringFormat="{DynamicResource LOCPaSuccessStoryGoal}" />
        </DockPanel>
    </DataTemplate>

    <DataTemplate x:Key="PaActivityScreenshotsTaken">
        <DockPanel Margin="0,0,0,10">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock DockPanel.Dock="Right"
                           Style="{DynamicResource BaseTextBlockStyle}"
                           Foreground="{DynamicResource TextBrushDarker}"
                           ToolTip="{Binding DateActivity, Converter={StaticResource PaActivityLocalDateConverter}}"
                           Text="{Binding TimeAgo}" />
                <Label Margin="0,0,10,0" Padding="0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextBrush}"
                       Content="{Binding Value}"
                       ContentStringFormat="{DynamicResource LOCPaScreenshotsTaken}" />
            </DockPanel>
            <controls:PaScreenshotStrip
                GameContext="{Binding ElementName=PART_Root, Path=Tag.GameContext}"
                DateTaked="{Binding DateActivity}" />
        </DockPanel>
    </DataTemplate>

    <DataTemplate x:Key="PaActivityPlaytimeFirst">
        <DockPanel Margin="0,0,0,10">
            <TextBlock DockPanel.Dock="Right"
                       Style="{DynamicResource BaseTextBlockStyle}"
                       Foreground="{DynamicResource TextBrushDarker}"
                       ToolTip="{Binding DateActivity, Converter={StaticResource PaActivityLocalDateConverter}}"
                       Text="{Binding TimeAgo}" />
            <TextBlock Style="{DynamicResource BaseTextBlockStyle}"
                       Margin="0,0,10,0"
                       Text="{DynamicResource LOCPaPlaytimeFirst}" />
        </DockPanel>
    </DataTemplate>

    <DataTemplate x:Key="PaActivityPlaytimeGoal">
        <DockPanel Margin="0,0,0,10">
            <TextBlock DockPanel.Dock="Right"
                       Style="{DynamicResource BaseTextBlockStyle}"
                       Foreground="{DynamicResource TextBrushDarker}"
                       ToolTip="{Binding DateActivity, Converter={StaticResource PaActivityLocalDateConverter}}"
                       Text="{Binding TimeAgo}" />
            <Label Margin="0,0,10,0" Padding="0"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource TextBrush}"
                   Content="{Binding Value}"
                   ContentStringFormat="{DynamicResource LOCPaPlaytimeGoal}" />
        </DockPanel>
    </DataTemplate>

    <DataTemplate x:Key="PaActivityHowLongToBeatCompleted">
        <DockPanel Margin="0,0,0,10">
            <TextBlock DockPanel.Dock="Right"
                       Style="{DynamicResource BaseTextBlockStyle}"
                       Foreground="{DynamicResource TextBrushDarker}"
                       ToolTip="{Binding DateActivity, Converter={StaticResource PaActivityLocalDateConverter}}"
                       Text="{Binding TimeAgo}" />
            <TextBlock Style="{DynamicResource BaseTextBlockStyle}"
                       Margin="0,0,10,0"
                       Text="{DynamicResource LOCPaHowLongToBeatCompleted}" />
        </DockPanel>
    </DataTemplate>

    <views:ActivityTypeTemplateSelector x:Key="PaActivityTypeTemplateSelector"
                                        AchievementsUnlockedTemplate="{StaticResource PaActivityAchievementsUnlocked}"
                                        AchievementsGoalTemplate="{StaticResource PaActivityAchievementsGoal}"
                                        ScreenshotsTakenTemplate="{StaticResource PaActivityScreenshotsTaken}"
                                        PlaytimeFirstTemplate="{StaticResource PaActivityPlaytimeFirst}"
                                        PlaytimeGoalTemplate="{StaticResource PaActivityPlaytimeGoal}"
                                        HowLongToBeatCompletedTemplate="{StaticResource PaActivityHowLongToBeatCompleted}" />
</ResourceDictionary>
