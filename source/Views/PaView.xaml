<UserControl x:Class="PlayerActivities.Views.PaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PlayerActivities.Views" 
             xmlns:controls="clr-namespace:PlayerActivities.Controls"
             xmlns:convertersshared="clr-namespace:CommonPluginsShared.Converters" 
             xmlns:controls1="clr-namespace:CommonPluginsShared.Controls" 
             xmlns:controls2="clr-namespace:CommonPluginsControls.Controls" 
             xmlns:playnitecontrols="clr-namespace:CommonPluginsControls.PlayniteControls" 
             xmlns:plugins="clr-namespace:CommonPluginsShared.Plugins" 
             xmlns:converters="clr-namespace:CommonPlayniteShared.Converters"
             mc:Ignorable="d" d:DesignHeight="740" d:DesignWidth="1280"
             d:DataContext="{d:DesignInstance Type=local:PaViewData}">

    <UserControl.Resources>
        <convertersshared:LocalDateConverter x:Key="LocalDateConverter" />
        <convertersshared:PlayTimeToStringConverterWithZero x:Key="PlayTimeToStringConverterWithZero" />
        <convertersshared:LocalDateTimeConverter x:Key="LocalDateTimeConverter" />
        <converters:StringNullOrEmptyToVisibilityConverter x:Key="StringNullOrEmptyToVisibilityConverter" />
        <converters:InvertedBooleanToVisibilityConverter x:Key="InvertedBooleanToVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!-- One template per ActivityType ; SS/SV strips read ExtensionsData (no GetGameViewControl) -->
        <!-- SourceIcon is shown once on the card header (PART_Root), not per activity line -->
        <DataTemplate x:Key="PaActivityAchievementsUnlocked">
            <DockPanel Margin="0,0,0,10">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Right"
                               Style="{DynamicResource BaseTextBlockStyle}"
                               Foreground="{DynamicResource TextBrushDarker}"
                               ToolTip="{Binding DateActivity, Converter={StaticResource LocalDateConverter}}"
                               Text="{Binding TimeAgo}" />
                    <!-- Label: Binding.StringFormat cannot take DynamicResource (XamlParseException) -->
                    <Label Margin="0,0,10,0" Padding="0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextBrush}"
                           Content="{Binding Value}"
                           ContentStringFormat="{DynamicResource LOCPaSuccessStoryUnlocked}" />
                </DockPanel>
                <controls:PaAchievementStrip
                    GameContext="{Binding ElementName=PART_Root, Path=Tag.GameContext}"
                    DateUnlocked="{Binding DateActivity}" />
            </DockPanel>
        </DataTemplate>

        <DataTemplate x:Key="PaActivityAchievementsGoal">
            <DockPanel Margin="0,0,0,10">
                <TextBlock DockPanel.Dock="Right"
                           Style="{DynamicResource BaseTextBlockStyle}"
                           Foreground="{DynamicResource TextBrushDarker}"
                           ToolTip="{Binding DateActivity, Converter={StaticResource LocalDateConverter}}"
                           Text="{Binding TimeAgo}" />
                <Label Margin="0,0,10,0" Padding="0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextBrush}"
                       Content="{Binding Value}"
                       ContentStringFormat="{DynamicResource LOCPaSuccessStoryGoal}" />
            </DockPanel>
        </DataTemplate>

        <DataTemplate x:Key="PaActivityScreenshotsTaken">
            <DockPanel Margin="0,0,0,10">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Right"
                               Style="{DynamicResource BaseTextBlockStyle}"
                               Foreground="{DynamicResource TextBrushDarker}"
                               ToolTip="{Binding DateActivity, Converter={StaticResource LocalDateConverter}}"
                               Text="{Binding TimeAgo}" />
                    <Label Margin="0,0,10,0" Padding="0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextBrush}"
                           Content="{Binding Value}"
                           ContentStringFormat="{DynamicResource LOCPaScreenshotsTaken}" />
                </DockPanel>
                <controls:PaScreenshotStrip
                    GameContext="{Binding ElementName=PART_Root, Path=Tag.GameContext}"
                    DateTaked="{Binding DateActivity}" />
            </DockPanel>
        </DataTemplate>

        <DataTemplate x:Key="PaActivityPlaytimeFirst">
            <DockPanel Margin="0,0,0,10">
                <TextBlock DockPanel.Dock="Right"
                           Style="{DynamicResource BaseTextBlockStyle}"
                           Foreground="{DynamicResource TextBrushDarker}"
                           ToolTip="{Binding DateActivity, Converter={StaticResource LocalDateConverter}}"
                           Text="{Binding TimeAgo}" />
                <TextBlock Style="{DynamicResource BaseTextBlockStyle}"
                           Margin="0,0,10,0"
                           Text="{DynamicResource LOCPaPlaytimeFirst}" />
            </DockPanel>
        </DataTemplate>

        <DataTemplate x:Key="PaActivityPlaytimeGoal">
            <DockPanel Margin="0,0,0,10">
                <TextBlock DockPanel.Dock="Right"
                           Style="{DynamicResource BaseTextBlockStyle}"
                           Foreground="{DynamicResource TextBrushDarker}"
                           ToolTip="{Binding DateActivity, Converter={StaticResource LocalDateConverter}}"
                           Text="{Binding TimeAgo}" />
                <Label Margin="0,0,10,0" Padding="0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextBrush}"
                       Content="{Binding Value}"
                       ContentStringFormat="{DynamicResource LOCPaPlaytimeGoal}" />
            </DockPanel>
        </DataTemplate>

        <DataTemplate x:Key="PaActivityHowLongToBeatCompleted">
            <DockPanel Margin="0,0,0,10">
                <TextBlock DockPanel.Dock="Right"
                           Style="{DynamicResource BaseTextBlockStyle}"
                           Foreground="{DynamicResource TextBrushDarker}"
                           ToolTip="{Binding DateActivity, Converter={StaticResource LocalDateConverter}}"
                           Text="{Binding TimeAgo}" />
                <TextBlock Style="{DynamicResource BaseTextBlockStyle}"
                           Margin="0,0,10,0"
                           Text="{DynamicResource LOCPaHowLongToBeatCompleted}" />
            </DockPanel>
        </DataTemplate>

        <local:ActivityTypeTemplateSelector x:Key="PaActivityTypeTemplateSelector"
                                            AchievementsUnlockedTemplate="{StaticResource PaActivityAchievementsUnlocked}"
                                            AchievementsGoalTemplate="{StaticResource PaActivityAchievementsGoal}"
                                            ScreenshotsTakenTemplate="{StaticResource PaActivityScreenshotsTaken}"
                                            PlaytimeFirstTemplate="{StaticResource PaActivityPlaytimeFirst}"
                                            PlaytimeGoalTemplate="{StaticResource PaActivityPlaytimeGoal}"
                                            HowLongToBeatCompletedTemplate="{StaticResource PaActivityHowLongToBeatCompleted}" />

        <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu>
                        <MenuItem
                            Visibility="{Binding GameContext.IsInstalled, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Command="{Binding DataContext.StartGameCommand, Source={x:Reference Name=PART_LbTimeLine}}"
                            CommandParameter="{Binding GameContext}">
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xec74;" FontFamily="{DynamicResource FontIcoFont}" Width="20" Margin="-5,0,0,0" />
                                    <TextBlock Text="{DynamicResource LOCPlayGame}" />
                                </StackPanel>
                            </MenuItem.Header>
                        </MenuItem>
                        <MenuItem
                            Visibility="{Binding GameContext.IsInstalled, Converter={StaticResource InvertedBooleanToVisibilityConverter}}"
                            Command="{Binding DataContext.InstallGameCommand, Source={x:Reference Name=PART_LbTimeLine}}"
                            CommandParameter="{Binding GameContext}">
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xef08;" FontFamily="{DynamicResource FontIcoFont}" Width="20" Margin="-5,0,0,0" />
                                    <TextBlock Text="{DynamicResource LOCInstallGame}" />
                                </StackPanel>
                            </MenuItem.Header>
                        </MenuItem>
                        
                        <MenuItem
                            Command="{Binding DataContext.ShowGameInLibraryCommand, Source={x:Reference Name=PART_LbTimeLine}}"
                            CommandParameter="{Binding GameContext}">
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xef19;" FontFamily="{DynamicResource FontIcoFont}" Width="20" Margin="-5,0,0,0" />
                                    <TextBlock Text="{DynamicResource LOCPaShowGameInLibrary}" />
                                </StackPanel>
                            </MenuItem.Header>
                        </MenuItem>

                        <Separator />

                        <MenuItem
                            Command="{Binding DataContext.RefreshGameDataCommand, Source={x:Reference Name=PART_LbTimeLine}}"
                            CommandParameter="{Binding GameContext}">
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xefd1;" FontFamily="{DynamicResource FontIcoFont}" Width="20" Margin="-5,0,0,0" />
                                    <TextBlock Text="{DynamicResource LOCPaRefreshGameData}" />
                                </StackPanel>
                            </MenuItem.Header>
                        </MenuItem>

                        <MenuItem 
                            Visibility="{Binding ShowSuccessStoryMenu, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Command="{Binding DataContext.ShowGameSuccessStoryCommand, Source={x:Reference Name=PART_LbTimeLine}}"
                            CommandParameter="{Binding GameContext}">
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xe820;" FontFamily="{DynamicResource FontIcoFont}" Width="20" Margin="-5,0,0,0" />
                                    <TextBlock Text="{DynamicResource LOCPaSuccessStoryPluginView}" />
                                </StackPanel>
                            </MenuItem.Header>
                        </MenuItem>

                        <MenuItem 
                            Visibility="{Binding ShowHowLongToBeatMenu, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Command="{Binding DataContext.ShowGameHowLongToBeatCommand, Source={x:Reference Name=PART_LbTimeLine}}"
                            CommandParameter="{Binding GameContext}">
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xe90d;" FontFamily="{DynamicResource CommonFont}" Width="20" Margin="-5,0,0,0" />
                                    <TextBlock Text="{DynamicResource LOCPaHowLongToBeatPluginView}" />
                                </StackPanel>
                            </MenuItem.Header>
                        </MenuItem>

                        <MenuItem 
                            Visibility="{Binding ShowScreenshotsVisualizerMenu, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Command="{Binding DataContext.ShowGameScreenshotsVisualizerCommand, Source={x:Reference Name=PART_LbTimeLine}}"
                            CommandParameter="{Binding GameContext}">
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xea38;" FontFamily="{DynamicResource CommonFont}" Width="20" Margin="-5,0,0,0" />
                                    <TextBlock Text="{DynamicResource LOCPaScreenshotsVisualizerPluginView}" />
                                </StackPanel>
                            </MenuItem.Header>
                        </MenuItem>
                    </ContextMenu>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid Name="PART_DataLoad">
            <ProgressBar IsIndeterminate="True" Width="350" Height="40" />
            <TextBlock Text="{DynamicResource LOCLoadingLabel}"
                    Style="{DynamicResource BaseTextBlockStyle}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>

        <Grid Name="PART_Data">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="PART_ColFeed" Width="1.5*" />
                <ColumnDefinition x:Name="PART_ColFriendsGap" Width="20" />
                <ColumnDefinition x:Name="PART_ColFriends" Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Filter -->
                <Border Grid.Row="0" BorderThickness="{DynamicResource PopupBorderThickness}" BorderBrush="{DynamicResource NormalBorderBrush}">
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="250" />
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="0" Content="{DynamicResource LOCSearchLabel}" FontSize="16" />
                        <playnitecontrols:SearchBox Grid.Column="2" x:Name="TextboxSearch" TextChanged="TextboxSearch_TextChanged" />

                        <Label Grid.Column="4" Content="{DynamicResource LOCSourceLabel}" FontSize="16" />
                        <ComboBox Grid.Column="6" Name="FilterSource" ItemsSource="{Binding FilterSourceItems}" IsEditable="True" IsReadOnly="True">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Name="chkSource" Checked="ChkSource_Checked" Unchecked="ChkSource_Unchecked" Tag="{Binding SourceNameShort}"
                                              Content="{Binding SourceName}" IsChecked="{Binding IsCheck, Mode=TwoWay}" FontFamily="{DynamicResource CommonFont}">
                                    </CheckBox>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </Border>

                <TextBlock Grid.Row="2"
                           Style="{DynamicResource SectionHeaderText}"
                           Text="{DynamicResource LOCPaActivities}"
                           Margin="0" />

                <!-- Player time line -->
                <Grid Name="PART_GridContener" Grid.Row="4" ClipToBounds="True">
                    <ListBox Name="PART_LbTimeLine"
                             ItemsSource="{Binding ItemsSource}"
                             BorderThickness="0"
                             Width="{Binding ElementName=PART_GridContener, Path=ActualWidth}"
                             Height="{Binding ElementName=PART_GridContener, Path=ActualHeight}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">

                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                            <Grid>
                                                <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="3,0,0,0" />
                                                </Border>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>

                                <Style.Triggers>
                                    <Trigger Property="Selector.IsSelected" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrushDark}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10"
                                        Padding="8"
                                        BorderThickness="{DynamicResource PopupBorderThickness}"
                                        BorderBrush="{DynamicResource NormalBorderBrush}"
                                        Background="{DynamicResource PopupBackgroundBrush}"
                                        CornerRadius="{DynamicResource ControlCornerRadius}">
                                    <Grid Name="PART_Root" Tag="{Binding}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <controls1:ImageAsync Grid.Column="0"
                                                              Source="{Binding CoverImage}"
                                                              Stretch="Uniform"
                                                              ToolTip="{Binding GameContext.Name}"
                                                              DecodePixelHeight="80"
                                                              MaxHeight="80"
                                                              VerticalAlignment="Top"
                                                              HorizontalAlignment="Center" />

                                        <DockPanel Grid.Column="2" LastChildFill="True">
                                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="True">
                                                <TextBlock DockPanel.Dock="Right"
                                                           Style="{DynamicResource BaseTextBlockStyle}"
                                                           Foreground="{DynamicResource TextBrushDarker}"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding TimeAgo}" />
                                                <TextBlock DockPanel.Dock="Left"
                                                           Style="{DynamicResource BaseTextBlockStyle}"
                                                           FontFamily="{DynamicResource CommonFont}"
                                                           Foreground="{DynamicResource GlyphBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"
                                                           Text="{Binding SourceIcon}"
                                                           Visibility="{Binding SourceIcon, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}" />
                                                <TextBlock Style="{DynamicResource BaseTextBlockStyle}"
                                                           FontSize="{DynamicResource FontSizeLarge}"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding GameContext.Name}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </DockPanel>

                                            <ItemsControl Name="PART_ItemsControl"
                                                          ItemsSource="{Binding ActivitiesOrdered}"
                                                          ItemTemplateSelector="{StaticResource PaActivityTypeTemplateSelector}" />
                                        </DockPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>

            <!-- List of friends (collapsed via PART_ColFriends* widths) -->
            <Grid Grid.Column="2" Name="PART_FriendsPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="True">
                    <!-- Chevron &#xEA69; = ModernExpanderStyle (PlayniteBase IcoFont); rotate when collapsed -->
                    <Button DockPanel.Dock="Right"
                            Name="PART_BtToggleFriends"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0"
                            Click="Button_ToggleFriendsPanel_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Setter Property="Content" Value="&#xEA69;" />
                                <Setter Property="ToolTip" Value="{DynamicResource LOCCollapse}" />
                                <Setter Property="LayoutTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="0" />
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFriendsPanelExpanded}" Value="False">
                                        <Setter Property="ToolTip" Value="{DynamicResource LOCExpand}" />
                                        <Setter Property="LayoutTransform">
                                            <Setter.Value>
                                                <RotateTransform Angle="180" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <TextBlock Name="PART_FriendsHeaderTitle"
                               Style="{DynamicResource SectionHeaderText}"
                               Text="{DynamicResource LOCPaFriends}"
                               VerticalAlignment="Center"
                               Margin="0" />
                </DockPanel>

                <Grid Name="PART_GridFriendsContener" Grid.Row="2">
                    <controls1:ListViewExtend x:Name="PART_LvFriends"
                                              Height="{Binding ElementName=PART_GridFriendsContener, Path=ActualHeight}"
                                              FontSize="24" Style="{StaticResource {x:Type ListView}}" 
                                              SortingEnable="True" SortingDefaultDataName="Stats.Playtime" SortingSortDirection="Descending"
                                              SelectionChanged="ListViewExtend_SelectionChanged"
                                              ItemsSource="{Binding FriendsSource}">

                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="65"
                                                controls1:ListViewColumnOptions.DisableSorting="True">
                                    <GridViewColumnHeader Content="{DynamicResource LOCActionsLabel}" />
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button ToolTip="{DynamicResource LOCCommonRefreshGameData}" HorizontalAlignment="Center"
                                                    Tag="{Binding}" Click="Button_Click"
                                                    Content="&#xefd1;" FontFamily="{DynamicResource FontIcoFont}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                
                                <GridViewColumn Width="50"
                                                controls1:ListViewColumnOptions.DisableSorting="True">
                                    <GridViewColumnHeader Content="{DynamicResource LOCGameIconTitle}" />
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Image HorizontalAlignment="Center" Height="32" VerticalAlignment="Center" Width="32" 
                                                       Source="{Binding FriendsAvatar, IsAsync=True}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Width="0" DisplayMemberBinding="{Binding FriendPseudo}"
                                                controls1:ListViewColumnOptions.ForceHidden="True">
                                    <controls1:GridViewColumnHeaderExtend Style="{StaticResource {x:Type GridViewColumnHeader}}" IsHitTestVisible="False" />
                                </GridViewColumn>
                                <GridViewColumn Width="140"
                                                controls1:ListViewColumnOptions.SortMemberPath="FriendPseudo">
                                    <GridViewColumnHeader Content="{DynamicResource LOCGameNameTitle}" />
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock ToolTip="{Binding FriendsLink}">
                                                <Hyperlink Command="{Binding NavigateUrl}" CommandParameter="{Binding FriendsLink}">
                                                    <controls2:TextBlockTrimmed Text="{Binding FriendPseudo}" Style="{DynamicResource ListExtendStyleTextBlock}" />
                                                </Hyperlink>
                                            </TextBlock>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Width="0" DisplayMemberBinding="{Binding ClientName}"
                                                controls1:ListViewColumnOptions.ForceHidden="True">
                                    <controls1:GridViewColumnHeaderExtend Style="{StaticResource {x:Type GridViewColumnHeader}}" IsHitTestVisible="False" />
                                </GridViewColumn>
                                <GridViewColumn Width="75"
                                                controls1:ListViewColumnOptions.SortMemberPath="ClientName">
                                    <GridViewColumnHeader Name="lvSourceIcon" Content="{DynamicResource LOCSourceLabel}" />
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Label Content="{Binding ClientIcon}" FontFamily="{DynamicResource CommonFont}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Stretch" FontSize="30" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- Phase A: compact leaderboard columns (AcceptedAt / GamesOwned / LastUpdate removed) -->
                                <GridViewColumn Width="90" DisplayMemberBinding="{Binding Stats.Achievements}">
                                    <GridViewColumnHeader Content="{DynamicResource LOCPaAchievements}" />
                                </GridViewColumn>

                                <GridViewColumn Width="120" DisplayMemberBinding="{Binding Stats.Playtime, Converter={StaticResource PlayTimeToStringConverterWithZero}}">
                                    <GridViewColumnHeader Content="{DynamicResource LOCStatsTotalPlayTime}" />
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </controls1:ListViewExtend>
                </Grid>

                <Grid Name="PART_GridFriendsDetailsContener" Grid.Row="4">
                    <controls1:ListViewExtend Height="{Binding ElementName=PART_GridFriendsDetailsContener, Path=ActualHeight}"
                                              FontSize="24" Style="{StaticResource {x:Type ListView}}" 
                                              SortingEnable="True" SortingDefaultDataName="Name" SortingSortDirection="Ascending"
                                              x:Name="PART_LvFriendsDetails"
                                              ItemsSource="{Binding FriendsDetailsSource}">

                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="0" DisplayMemberBinding="{Binding Name}"
                                                controls1:ListViewColumnOptions.ForceHidden="True">
                                    <controls1:GridViewColumnHeaderExtend Style="{StaticResource {x:Type GridViewColumnHeader}}" IsHitTestVisible="False" />
                                </GridViewColumn>
                                <GridViewColumn Width="170"
                                                controls1:ListViewColumnOptions.SortMemberPath="Name">
                                    <GridViewColumnHeader Content="{DynamicResource LOCGameNameTitle}" />
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock ToolTip="{Binding Link}"
                                                           Visibility="{Binding Link, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
                                                    <Hyperlink Command="{Binding NavigateUrl}" CommandParameter="{Binding Link}">
                                                        <controls2:TextBlockTrimmed Text="{Binding Name}" Style="{DynamicResource ListExtendStyleTextBlock}" />
                                                    </Hyperlink>
                                                </TextBlock>


                                                <TextBlock Text="{Binding Name}"
                                                           Visibility="{Binding Link, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}, ConverterParameter=Inverted}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Width="0" DisplayMemberBinding="{Binding IsCommun}"
                                                controls1:ListViewColumnOptions.ForceHidden="True">
                                    <controls1:GridViewColumnHeaderExtend Style="{StaticResource {x:Type GridViewColumnHeader}}" IsHitTestVisible="False" />
                                </GridViewColumn>
                                <GridViewColumn Width="90"
                                                controls1:ListViewColumnOptions.SortMemberPath="IsCommun">
                                    <GridViewColumnHeader Content="{DynamicResource LOCPaCommon}" />
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsCommun}" HorizontalAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Width="140" DisplayMemberBinding="{Binding Playtime, Converter={StaticResource PlayTimeToStringConverterWithZero}}">
                                    <GridViewColumnHeader Content="{DynamicResource LOCPaFriendPlaytime}" />
                                </GridViewColumn>

                                <GridViewColumn Width="140" DisplayMemberBinding="{Binding UsPlaytime, Converter={StaticResource PlayTimeToStringConverterWithZero}}">
                                    <GridViewColumnHeader Content="{DynamicResource LOCPaYourPlaytime}" />
                                </GridViewColumn>
                                
                                <GridViewColumn Width="100" DisplayMemberBinding="{Binding Achievements}">
                                    <GridViewColumnHeader Content="{DynamicResource LOCPaFriendAchievements}" />
                                </GridViewColumn>

                                <GridViewColumn Width="80" DisplayMemberBinding="{Binding UsAchievements}">
                                    <GridViewColumnHeader Content="{DynamicResource LOCPaYourAchievements}" />
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </controls1:ListViewExtend>
                </Grid>

                <Grid Name="PART_FriendsFooter" Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Margin="0,0,10,0" Name="PART_DataRerefsh" HorizontalAlignment="Center" Width="300">
                        <Label Content="{Binding FriendsDataLoading.SourceName, FallbackValue=SourceName}" />
                        <Grid Margin="10,0,0,0">
                            <ProgressBar Maximum="{Binding FriendsDataLoading.FriendCount}" Value="{Binding FriendsDataLoading.ActualCount}" Name="PART_Pb" Grid.Row="2" Height="30">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                        <Setter Property="IsIndeterminate" Value="false" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=PART_Pb, Path=Maximum}" Value="0">
                                                <Setter Property="IsIndeterminate" Value="True" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>
                            <Label Grid.Row="2" HorizontalAlignment="Center" Content="{Binding FriendsDataLoading.FriendName, FallbackValue=FriendName}" />
                        </Grid>
                    </DockPanel>

                    <Label Grid.Column="1" Visibility="{Binding ElementName=PART_DtUpdate, Path=Content, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}" Content="{DynamicResource LOCCommonLastUpdate}" />
                    <Label Grid.Column="3" Name="PART_DtUpdate" Content="{Binding LastFriendsRefresh, Converter={StaticResource LocalDateTimeConverter}}" />
                    <Button Name="PART_BtFriends" Grid.Column="5" Content="{DynamicResource LOCPaRefreshFriendsData}" Click="Button_RefreshFriendsData" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
